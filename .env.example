# ===== KMS BUMD (KnowBase) - Environment Backend & Frontend =====
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# --- Server ---
PORT=5000
APP_BASE_URL=https://ragkms.aiones.app

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kms_bumd

# --- Autentikasi ---
# WAJIB diganti dengan nilai acak kuat di produksi (mis. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d
# Sandi awal akun demo hasil seeding (superadmin@kms.id, admin@kms.id, user@kms.id)
DEMO_PASSWORD=password123

# --- RAG AI (server vektor) ---
RAG_BASE_URL=https://rag.aiones.app
# Kunci OPERATOR/master dari server RAG. Wajib diisi, kalau kosong indeks dokumen ditolak 401
# dan key per-project tidak bisa diterbitkan.
RAG_API_KEY=your_rag_api_key_here
# Opsional: knowledge base default bila project tidak punya kolom knowledge_base
RAG_DEFAULT_KB=
# Opsional: key khusus mode pengembangan
KMS_DEV_API_KEY=

# --- Kroombox Edge CDN ---
# WAJIB diisi dengan project CDN MILIK SENDIRI. Bila dikosongkan, aplikasi memakai
# kredensial default yang tertanam di kode sehingga berkas project lain ikut terlihat.
KROOMBOX_CDN_URL=https://api-cdn.kroombox.com
KROOMBOX_API_KEY=
KROOMBOX_JWT_TOKEN=
KROOMBOX_PROJECT_ID=

# --- Email pengirim (fitur lupa sandi, via Gmail API) ---
# Isi kredensial OAuth client (Google Cloud) lalu buka /api/auth/google/connect
# sekali sebagai admin untuk menyimpan GOOGLE_REFRESH_TOKEN secara otomatis.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=
MAIL_FROM_NAME=KMS BUMD

# --- Frontend (build produksi) ---
# Kosongkan untuk memakai /api pada domain yang sama
VITE_API_BASE_URL=/api
