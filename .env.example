# ===== KMS BUMD Backend Environment =====

# Server
PORT=5000

# MySQL Database (Laragon default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kms_bumd

# JWT Authentication
# Ganti dengan secret acak yang kuat di production (mis. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Password untuk akun demo hasil seeding (superadmin@kms.id, admin@bumd.go.id, dst.)
DEMO_PASSWORD=password123

# RAG AI Service
RAG_BASE_URL=https://rag.aiones.app
RAG_API_KEY=your_rag_api_key_here
